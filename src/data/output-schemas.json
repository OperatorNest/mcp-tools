            "modelFamilies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source": {
              "type": "string"
            },
            "modelSource": {
              "type": "string"
            },
            "checked": {
              "type": "string"
            },
            "sourceNote": {
              "type": "string"
