{
  "ai-api-cost-calculator": {
    "type": "object",
    "properties": {
      "tool": {
        "const": "ai-api-cost-calculator"
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "cachedInputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "requestsPerDay": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "requestsPerMonth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "modelIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          },
          "batchModelIds": {
            "type": "array",
            "minItems": 0,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "description": "Optional model IDs using a published batch discount."
          }
        },
        "required": [
          "inputTokens",
          "cachedInputTokens",
          "outputTokens",
          "requestsPerDay",
          "requestsPerMonth",
          "modelIds"
        ]
      },
      "units": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "method": {
        "type": "string"
      },
      "assumptions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "provenance": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "estimates": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "modelId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "perRequest": {
              "type": [
                "number",
                "null"
              ]
            },
            "perDay": {
              "type": [
                "number",
                "null"
              ]
            },
            "perMonth": {
              "type": [
                "number",
                "null"
              ]
            },
            "longContext": {
              "type": "boolean"
            },
            "batch": {
              "type": "boolean"
            },
            "ratesPerMillion": {
              "type": "object",
              "properties": {
                "input": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "cachedInput": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "output": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "input",
                "cachedInput",
                "output"
              ],
              "additionalProperties": false
            },
            "sourceUrl": {
              "type": "string",
              "format": "uri"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "modelId",
            "name",
            "perRequest",
            "perDay",
            "perMonth",
            "longContext",
            "batch",
            "ratesPerMillion",
            "sourceUrl",
            "note"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "tool",
      "input",
      "units",
      "method",
      "assumptions",
      "provenance",
      "estimates"
    ],
    "additionalProperties": false
  },
  "meeting-time-zone-planner": {
    "type": "object",
    "properties": {
      "tool": {
        "const": "meeting-time-zone-planner"
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Real date from 2000-01-01 to 2100-12-31."
          },
          "people": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "\\S"
                },
                "zone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "\\S",
                  "description": "An IANA time zone supported by Intl.DateTimeFormat, such as America/New_York."
                }
              },
              "required": [
                "name",
                "zone"
              ]
            }
          }
        },
        "required": [
          "date",
          "people"
        ]
      },
      "units": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "method": {
        "type": "string"
      },
      "assumptions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "provenance": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "rows": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "description": "Unix epoch milliseconds."
            },
            "startUtc": {
              "type": "string",
              "format": "date-time"
            },
            "inside": {
              "type": "array",
              "items": {
                "type": "boolean"
              }
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "score": {
              "type": "number"
            }
          },
          "required": [
            "start",
            "startUtc",
            "inside",
            "labels",
            "score"
          ],
          "additionalProperties": false
        }
      },
      "overlapCount": {
        "type": "integer",
        "minimum": 0
      },
      "bestSlots": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "description": "Unix epoch milliseconds."
            },
            "startUtc": {
              "type": "string",
              "format": "date-time"
            },
            "inside": {
              "type": "array",
              "items": {
                "type": "boolean"
              }
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "score": {
              "type": "number"
            }
          },
          "required": [
            "start",
            "startUtc",
            "inside",
            "labels",
            "score"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "tool",
      "input",
      "units",
      "method",
      "assumptions",
      "provenance",
      "rows",
      "overlapCount",
      "bestSlots"
    ],
    "additionalProperties": false
  },
  "recurring-task-planner": {
    "type": "object",
    "properties": {
      "tool": {
        "const": "recurring-task-planner"
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Real date from 2000-01-01 to 2100-12-31."
          },
          "tasks": {
            "type": "array",
            "minItems": 0,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "\\S"
                },
                "frequency": {
                  "type": "string",
                  "enum": [
                    "weekly",
                    "biweekly",
                    "monthly"
                  ]
                },
                "day": {
                  "type": "string",
                  "enum": [
                    "MO",
                    "TU",
                    "WE",
                    "TH",
                    "FR",
                    "SA",
                    "SU"
                  ]
                },
                "monthday": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 28
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1440
                },
                "time": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "owner": {
                  "type": "string",
                  "enum": [
                    "delegate",
                    "keep",
                    "decide"
                  ]
                }
              },
              "required": [
                "title",
                "frequency",
                "day",
                "monthday",
                "minutes",
                "time",
                "owner"
              ]
            }
          }
        },
        "required": [
          "startDate",
          "tasks"
        ]
      },
      "units": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "method": {
        "type": "string"
      },
      "assumptions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "provenance": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "monthlyHours": {
        "type": "number"
      },
      "schedules": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "\\S"
            },
            "frequency": {
              "type": "string",
              "enum": [
                "weekly",
                "biweekly",
                "monthly"
              ]
            },
            "day": {
              "type": "string",
              "enum": [
                "MO",
                "TU",
                "WE",
                "TH",
                "FR",
                "SA",
                "SU"
              ]
            },
            "monthday": {
              "type": "integer",
              "minimum": 1,
              "maximum": 28
            },
            "minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440
            },
            "time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "owner": {
              "type": "string",
              "enum": [
                "delegate",
                "keep",
                "decide"
              ]
            },
            "firstDate": {
              "type": "string",
              "format": "date"
            },
            "recurrenceRule": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "frequency",
            "day",
            "monthday",
            "minutes",
            "time",
            "owner",
            "firstDate",
            "recurrenceRule"
          ],
          "additionalProperties": false
        }
      },
      "ics": {
        "type": "string",
        "description": "RFC 5545 calendar with CRLF folding and floating local times."
      }
    },
    "required": [
      "tool",
      "input",
      "units",
      "method",
      "assumptions",
      "provenance",
      "monthlyHours",
      "schedules",
      "ics"
    ],
    "additionalProperties": false
  },
