          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "planIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
            "label",
            "planIds"
          ],
          "additionalProperties": false
        }
      },
      "provenance": {
        "type": "object",
        "properties": {
          "checked": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "planId": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "checked": {
                  "type": "string"
