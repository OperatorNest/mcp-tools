    "additionalProperties": false
  },
  "cron-expression-generator": {
    "type": "object",
    "properties": {
      "tool": {
        "const": "cron-expression-generator"
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "dialect": {
            "type": "string",
            "enum": [
              "github",
              "cloudflare",
              "quartz",
              "aws"
            ]
          },
          "zone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "after": {
            "type": "string",
            "format": "date-time",
            "maxLength": 30,
            "description": "UTC ISO instant from 2000 through 2100; matches are strictly after this instant."
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "expression",
          "dialect",
          "zone",
          "after",
          "count"
        ]
      },
      "method": {
        "type": "string"
      },
      "assumptions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "runs": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "properties": {
            "startUtc": {
              "type": "string",
              "format": "date-time"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "startUtc",
            "label"
          ],
          "additionalProperties": false
        }
      },
      "searchDays": {
        "const": 366
      },
      "provenance": {
        "type": "object",
        "properties": {
          "sourceUrl": {
            "type": "string"
          },
          "checked": {
            "type": "string"
          }
        },
        "required": [
          "sourceUrl",
          "checked"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "tool",
      "input",
      "method",
      "assumptions",
      "runs",
      "searchDays",
      "provenance"
    ],
    "additionalProperties": false
  }
}
